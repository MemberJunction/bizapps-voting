{
  "name": "@mj-biz-apps/voting-server",
  "version": "0.0.0",
  "type": "module",
  "description": "Server bootstrap package - loaded by MJAPI at startup via the manifest's startupExport. TODO(template): rename.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "test": "vitest run --passWithNoTests"
  },
  "memberjunction": {
    "serverExtensions": [
      {
        "Enabled": true,
        "DriverClass": "VotingBallotEdge",
        "RootPath": "/vote",
        "OwnsCORS": true,
        "Settings": {}
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-voting"
  },
  "license": "BUSL-1.1",
  "dependencies": {
    "@mj-biz-apps/voting-actions": "0.0.0",
    "@mj-biz-apps/voting-core-entities-server": "0.0.0",
    "@mj-biz-apps/voting-entities": "0.0.0",
    "class-validator": "^0.14.3",
    "@mj-biz-apps/voting-engine-base": "0.0.0",
    "body-parser": "^2.2.0"
  },
  "peerDependencies": {
    "@memberjunction/core": "^6.2.0-edge.4",
    "@memberjunction/global": "^6.2.0-edge.4",
    "@memberjunction/server": "^6.2.0-edge.4",
    "@memberjunction/sqlserver-dataprovider": "^6.2.0-edge.4",
    "@memberjunction/core-entities": "^6.2.0-edge.4",
    "@memberjunction/core-entities-server": "^6.2.0-edge.4",
    "@memberjunction/server-extensions-core": "^6.2.0-edge.4",
    "@memberjunction/generic-database-provider": "^6.2.0-edge.4",
    "@memberjunction/encryption": "^6.2.0-edge.4",
    "@memberjunction/communication-engine": "^6.2.0-edge.4",
    "@memberjunction/communication-types": "^6.2.0-edge.4",
    "@memberjunction/scheduling-engine": "^6.2.0-edge.4",
    "@memberjunction/scheduling-base-types": "^6.2.0-edge.4",
    "@memberjunction/actions": "^6.2.0-edge.4",
    "@memberjunction/actions-base": "^6.2.0-edge.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@memberjunction/core": "6.2.0-edge.4",
    "@memberjunction/global": "6.2.0-edge.4",
    "@memberjunction/core-entities": "6.2.0-edge.4",
    "@memberjunction/core-entities-server": "6.2.0-edge.4",
    "@memberjunction/server": "6.2.0-edge.4",
    "@memberjunction/server-extensions-core": "6.2.0-edge.4",
    "@memberjunction/sqlserver-dataprovider": "6.2.0-edge.4",
    "@memberjunction/generic-database-provider": "6.2.0-edge.4",
    "@memberjunction/encryption": "6.2.0-edge.4",
    "@memberjunction/communication-engine": "6.2.0-edge.4",
    "@memberjunction/communication-types": "6.2.0-edge.4",
    "@memberjunction/scheduling-engine": "6.2.0-edge.4",
    "@memberjunction/scheduling-base-types": "6.2.0-edge.4",
    "@memberjunction/actions": "6.2.0-edge.4",
    "@memberjunction/actions-base": "6.2.0-edge.4",
