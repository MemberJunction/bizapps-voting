# pnpm settings for this repo, matching MJ core and the first-party BizApps repos
# (the proven Open App workspace baseline).
#
# package-manager-strict: lets pnpm run in a tree whose packageManager field may
#   disagree — which is exactly what happens when this repo is linked as a member of
#   an MJ checkout alongside repos that still pin npm.
# strict-peer-dependencies: peer mismatches warn instead of failing. MJ's own estate
#   straddles adjacent 6.1.0-edge.* peer pins, so mismatches are expected and are not
#   a reason to refuse an install.
# auto-install-peers: pnpm's default; stated explicitly because turning it off stops
#   declared peers being available at build time.
#
# Any stray `npm` command run here will print "Unknown project config" for these
# lines — that is npm not recognising pnpm settings, not breakage. This repo is pnpm:
# see docs/template-docs/getting-started.md.
package-manager-strict=false
strict-peer-dependencies=false
auto-install-peers=true
