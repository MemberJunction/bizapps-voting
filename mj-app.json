{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "mj-bizapps-voting",
  "displayName": "BizApps Voting",
  "description": "Secret, verifiable, embeddable voting (motions, elections, referendums and polls) for any app built on MemberJunction",
  "version": "0.0.0",
  "license": "BUSL-1.1",
  "icon": "fa-solid fa-check-to-slot",
  "color": "#264FAF",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/bizapps-voting",
  "mjVersionRange": ">=6.2.0-edge.5 <7.0.0",
  "dependencies": {
    "mj-bizapps-common": {
      "version": ">=5.46.1 <6.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-common"
    }
  },
  "schema": {
    "name": "__mj_BizAppsVoting",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@mj-biz-apps/voting-server",
        "role": "bootstrap",
        "startupExport": "LoadBizAppsVotingServer"
      },
      {
        "name": "@mj-biz-apps/voting-core-entities-server",
        "role": "library"
      }
    ],
    "client": [
      {
        "name": "@mj-biz-apps/voting-ng",
        "role": "bootstrap",
        "startupExport": "LoadBizAppsVotingClient"
      },
      {
        "name": "@mj-biz-apps/voting-ng-widgets",
        "role": "library"
      }
    ],
    "shared": [
      {
        "name": "@mj-biz-apps/voting-entities",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/voting-actions",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/voting-engine-base",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": [
    "Business",
    "Governance",
    "Voting"
  ],
  "tags": [
    "voting",
    "elections",
    "ballots",
    "motions",
    "referendums",
    "polls",
    "secret-ballot",
    "governance"
  ]
}
